@model Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-lg overflow-hidden">
                <img src="~/images/@Model.ImageUrl" class="img-fluid" alt="@Model.Name" style="max-height: 500px; object-fit: cover;">
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-lg p-4">
                <h1 class="display-4 font-weight-bold text-primary">@Model.Name</h1>
                <p class="lead text-muted">@Model.Description</p>
                <hr class="my-4" />
                <ul class="list-unstyled">
                    <li class="mb-3">
                        <strong class="text-dark">Price:</strong>
                        <span class="text-success font-weight-bold">$@Model.Price</span>
                    </li>
                    <li class="mb-3">
                        <strong class="text-dark">Stock Quantity:</strong>
                        <span class="badge bg-info text-white">@Model.StockQuantity</span>
                    </li>
                    <li class="mb-3">
                        <strong class="text-dark">Color:</strong>
                        <span class="badge" style="background-color: @Model.Color; color: white;">@Model.Color</span>
                    </li>
                    <li class="mb-3">
                        <strong class="text-dark">Dimensions:</strong>
                        <span class="text-secondary">@Model.Dimensions</span>
                    </li>
                    <li class="mb-3">
                        <strong class="text-dark">Material:</strong>
                        <span class="text-secondary">@Model.Material</span>
                    </li>
                    <li class="mb-3">
                        <strong class="text-dark">Created At:</strong>
                        <span class="text-secondary">@Model.CreatedAt.ToString("yyyy-MM-dd")</span>
                    </li>
                    <li class="mb-3">
                        <strong class="text-dark">Updated At:</strong>
                        <span class="text-secondary">@(Model.UpdatedAt?.ToString("yyyy-MM-dd") ?? "N/A")</span>
                    </li>
                </ul>
                <div class="mt-4 d-flex gap-2">
                    <a href="@Url.Action("Edit", "Home", new { id = Model.Id })" class="btn btn-warning btn-lg flex-grow-1">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a id="DeleteClick" class="btn btn-danger btn-lg flex-grow-1">
                        <i class="fas fa-trash"></i> Delete
                    </a>
                </div>
                <div class="mt-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg w-100">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(productId) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {

                window.location.href = '@Url.Action("Delete", "Home")' + '?id=' + productId;
            }
        });
    }
</script>